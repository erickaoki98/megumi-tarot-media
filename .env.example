# Configure these in Vercel Project Settings -> Environment Variables.
# Never expose these values in client-side code or localStorage.

# bundle.social — real publishing backend (handles OAuth/delivery per network).
# Get the API key from your bundle.social organization and the team id from GET /api/v1/team/.
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_TEAM_ID=
# Optional override (defaults to https://api.bundle.social/api/v1)
# BUNDLE_SOCIAL_API_BASE=

# Cloudflare R2 — media storage (S3-compatible). Uploaded media is stored here
# and its public URL is sent to bundle.social via /upload/from-url.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (r2.dev domain or your custom domain), no trailing slash.
R2_PUBLIC_BASE_URL=

# Legacy / manual per-network credentials (kept for reference; not used for publishing).
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
SOCIAL_INSTAGRAM_ACCESS_TOKEN=
SOCIAL_INSTAGRAM_ACCOUNT_ID=
SOCIAL_INSTAGRAM_PAGE_ID=
SOCIAL_INSTAGRAM_REDIRECT_URI=

SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_FACEBOOK_PAGE_ACCESS_TOKEN=
SOCIAL_FACEBOOK_PAGE_ID=
SOCIAL_FACEBOOK_REDIRECT_URI=

SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_REFRESH_TOKEN=
SOCIAL_YOUTUBE_CHANNEL_ID=
SOCIAL_YOUTUBE_REDIRECT_URI=

SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_ACCESS_TOKEN=
SOCIAL_TIKTOK_REFRESH_TOKEN=
SOCIAL_TIKTOK_OPEN_ID=
SOCIAL_TIKTOK_REDIRECT_URI=
